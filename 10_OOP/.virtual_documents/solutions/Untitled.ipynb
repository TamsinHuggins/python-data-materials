


from datetime import datetime

class Employee:
    VALID_STATUSES = ("full-time", "part-time", "contract")

    def __init__(self, name, salary, employment_status="full-time"):
        self.name = name
        self.salary = salary
        self.joined = datetime.now()
        self._employment_status = None
        self.set_employment_status(employment_status)

    def get_employment_status(self):
        return self._employment_status

    def set_employment_status(self, new_status):
        if new_status.lower() in self.VALID_STATUSES:
            self._employment_status = new_status.lower()
            return "Employment status updated successfully."
        else:
            return f"Invalid employment status: {new_status}. Valid statuses are: {', '.join(self.VALID_STATUSES)}."

    def pay_raise(self, amount):
        self.salary += amount

    def to_string(self):
        return f"{self.name} earns {self.salary}, joined {self.joined.strftime('%c')}, employment status: {self._employment_status}"



mike = Employee("James", 20000)


mike.salary


