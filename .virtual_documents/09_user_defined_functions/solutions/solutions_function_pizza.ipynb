











import math

PRICES = {
    "pepperoni": {9: 8, 11:12, 13:14},
    "margarita": {9:5, 11:9, 13:12},
    "veg-feast": {9:7, 11:10, 13:13}
    # add other flavours and their prices to the prices dictionary!
}

def order_pizza():
    flavour = handle_flavour()
    if flavour:
        size = handle_size(flavour)
        if size:
            cost = PRICES[flavour][size]
            processed_cost = handle_discount(cost)
            print(f'you have ordered a {size}" {flavour} pizza. That will cost £{processed_cost}')
            beers_price = calculate_beers(processed_cost)
            if beers_price:
                final_cost = processed_cost + beers_price
                print(f'Your final cost is £{final_cost}')
            
        else: 
            return None
    else:
        return None
    
    
def handle_flavour():
    flavour = input('Would you like Pepperoni, Margarita or Veg-Feast?: ').lower()
    if flavour in PRICES.keys():
        print(f"{flavour} is available")
        return flavour       
    else:
        print('not a valid flavour, try again')
        return None # indicates failure
    
    
    
def handle_size(chosen_flavour):
    try:
        size = int(input(f'Please choose between our 9", 11" or 13" pizza. Type 9, 11 or 13: '))
        if size in PRICES[chosen_flavour].keys():
            print(f"you selected {size}")
            return size
        else:

            print("please choose a valid size")
            return None  #indicates failure
    except:
        print("You must enter a number")
        return None     
        
def handle_discount(cost):
    code_entered = input('do you have a discount code? If so, type it here').lower()
    if code_entered == 'functionpizza':
        final_pizza_cost = cost * 0.8 # discount applied
        print(f"20% discount applied on £{cost} pizza. Pizza now £{final_pizza_cost}")
    else:
        print("Code entered incorrectly, discount not applied")
        final_pizza_cost = cost # no discount
    return final_pizza_cost


def calculate_beers(current_cost):
    try: 
        num_beers = int(input("How many beers would you like to order?"))
    except:
        print("No beers ordered")
        return 0
    is_happy_hour = input("Is it happy hour?")
    beer_price = num_beers * 4.5
    if is_happy_hour == 'yes':
        beer_price = (math.floor(num_beers / 2) + (num_beers % 2)) * 4.5
        print(f"{num_beers} beers ordered with happy hour discount")
    else:
        print(f"{num_beers} beers ordered with no discount")
    return beer_price


    
order_pizza()



